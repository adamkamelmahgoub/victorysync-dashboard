{
  "name": "victorysync-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "VictorySync CX Dashboard - server + client",
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "install-all": "npm install && npm --prefix ./server install && npm --prefix ./client install",
    "server:test": "npm run test --workspace=server",
    "client:test": "npm run build --workspace=client",
    "test:auth": "node --test tests/auth-persistence.test.js",
    "test:e2e": "node tests/smoke-e2e.js",
    "security:scan": "node scripts/security_scan.mjs && node scripts/security_endpoint_audit.mjs",
    "test:workforce": "node --test tests/workforce-database.test.mjs"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "playwright": "^1.61.1"
  }
}
