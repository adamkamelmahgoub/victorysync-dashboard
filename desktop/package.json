{
  "name": "victory-sync-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Visible, consent-based Windows workforce tracker",
  "author": "Victory Sync",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win dir",
    "package": "electron-builder --win nsis",
    "test": "node --test tests/*.test.cjs"
  },
  "build": {
    "appId": "com.victorysync.tracker",
    "productName": "Victory Sync Tracker",
    "files": [
      "*.cjs",
      "*.html",
      "*.css",
      "*.js",
      "package.json",
      "fonts/**"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  }
}
